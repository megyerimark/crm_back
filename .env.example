APP_NAME="VállalkozóOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Angular frontend (e-mail links, public form links, CORS)
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hu_HU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development works with SQLite out of the box; production uses MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ugyfelflow
# DB_USERNAME=root
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (Laravel Cashier) – the workspace is the paying customer
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Only for local development without the Stripe CLI; never enable in production
BILLING_ALLOW_UNSIGNED_WEBHOOKS=false
CASHIER_CURRENCY=huf
CASHIER_CURRENCY_LOCALE=hu
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Számlázz.hu e-invoices (issued automatically for every paid Stripe invoice)
SZAMLAZZ_ENABLED=false
SZAMLAZZ_AGENT_KEY=
SZAMLAZZ_PREFIX=
SZAMLAZZ_E_INVOICE=true
SZAMLAZZ_SEND_EMAIL=true
# VAT key on the invoice: 27 (default), or AAM for subject-exempt sellers; prices in config/plans.php are gross
BILLING_VAT_KEY=27
BILLING_PRICES_INCLUDE_VAT=true

# Super Admin console
ADMIN_REQUIRE_2FA=true
SUPPORT_NOTIFY_EMAILS=
